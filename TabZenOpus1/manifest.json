{
  "manifest_version": 3,
  "name": "TabZen",
  "version": "1.0.0",
  "description": "A calm visual workspace for your browser tabs",
  "permissions": ["tabs", "storage"],
  "chrome_url_overrides": {
    "newtab": "dashboard.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
